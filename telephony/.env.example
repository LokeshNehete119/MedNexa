# Copy to .env and fill in real values.
# All variables are prefixed MEDNEXA_TEL_.

# ── Backend API ──────────────────────────────────────────────────────────────
MEDNEXA_TEL_BACKEND_URL=http://localhost:8000
MEDNEXA_TEL_HOSPITAL_ID=<uuid-of-hospital-from-seed-script>

# ── Twilio ───────────────────────────────────────────────────────────────────
MEDNEXA_TEL_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MEDNEXA_TEL_TWILIO_AUTH_TOKEN=your_auth_token_here
MEDNEXA_TEL_TWILIO_PHONE_NUMBER=+14155552671
MEDNEXA_TEL_PUBLIC_URL=https://your-ngrok-url.ngrok.io

# ── STT (Faster-Whisper) ─────────────────────────────────────────────────────
MEDNEXA_TEL_WHISPER_MODEL_SIZE=large-v3
MEDNEXA_TEL_WHISPER_DEVICE=auto
MEDNEXA_TEL_WHISPER_COMPUTE_TYPE=int8
MEDNEXA_TEL_WHISPER_BEAM_SIZE=1
MEDNEXA_TEL_WHISPER_VAD_FILTER=true

# ── VAD (Silero) ─────────────────────────────────────────────────────────────
MEDNEXA_TEL_VAD_THRESHOLD=0.5
MEDNEXA_TEL_VAD_MIN_SPEECH_MS=250
MEDNEXA_TEL_VAD_MIN_SILENCE_MS=600

# ── TTS ──────────────────────────────────────────────────────────────────────
# 'piper' (local) or 'edge' (cloud free fallback)
MEDNEXA_TEL_TTS_ENGINE=piper
MEDNEXA_TEL_PIPER_BINARY=piper
MEDNEXA_TEL_PIPER_MODELS_DIR=models/piper
MEDNEXA_TEL_PIPER_VOICE_EN=en_US-amy-medium
MEDNEXA_TEL_PIPER_VOICE_HI=hi_IN-hemant-medium
MEDNEXA_TEL_EDGE_VOICE_EN=en-IN-NeerjaNeural
MEDNEXA_TEL_EDGE_VOICE_HI=hi-IN-SwaraNeural

# ── Call pipeline ────────────────────────────────────────────────────────────
MEDNEXA_TEL_CALL_TIMEOUT_SECONDS=300
MEDNEXA_TEL_SILENCE_TIMEOUT_SECONDS=30
MEDNEXA_TEL_BARGE_IN_ENABLED=true
MEDNEXA_TEL_MAX_CONCURRENT_CALLS=10

# ── Logging ──────────────────────────────────────────────────────────────────
MEDNEXA_TEL_LOG_LEVEL=INFO
MEDNEXA_TEL_ENABLE_RECORDINGS=false
MEDNEXA_TEL_RECORDINGS_DIR=recordings

# ── HTTP server ──────────────────────────────────────────────────────────────
MEDNEXA_TEL_SERVER_HOST=0.0.0.0
MEDNEXA_TEL_SERVER_PORT=8001

# ── AI agent (Part 2) ────────────────────────────────────────────────────────
# Install it with `uv sync --extra agent`; it also needs the backend database:
# MEDNEXA_DATABASE_URL=postgresql+asyncpg://mednexa:mednexa@localhost:5434/mednexa
# and its own MEDNEXA_AGENT_* settings (see agent/.env.example).
MEDNEXA_TEL_USE_STUB_AGENT=false
