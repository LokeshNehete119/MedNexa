# MedNexa Admin Dashboard environment variables (all server-side; nothing here reaches
# the browser). Copy to .env.local for development (never commit real values).

# Where the dashboard SERVER reaches the backend API. In Docker Compose: http://api:8000
BACKEND_URL=http://localhost:8000

# Cookies are Secure in production; set to "false" only when serving over plain HTTP
# (e.g. a hospital LAN without HTTPS; HTTPS is strongly preferred).
# AUTH_COOKIE_SECURE=true

# Sign-in is checked by the backend: configure MEDNEXA_ADMIN_EMAIL / MEDNEXA_ADMIN_PASSWORD /
# MEDNEXA_JWT_SECRET there (see backend/.env.example).
