# MedNexa Admin Dashboard environment variables.
# Copy to .env.local for development (never commit real values).

# Base URL of the FastAPI backend, as seen from the BROWSER. Baked in at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Staff sign-in (server-side only; never exposed to the browser) ──────────────
# Secret that signs session cookies: 32+ random characters, e.g. `openssl rand -hex 32`.
AUTH_SECRET=
# The staff account until Part 5 adds backend-issued JWTs (plan task 5.3).
STAFF_EMAIL=
STAFF_PASSWORD=
# Display name shown in the top bar (optional).
STAFF_NAME=Hospital Staff
# Cookies are Secure in production; set to "false" only when serving over plain HTTP.
# AUTH_COOKIE_SECURE=true
