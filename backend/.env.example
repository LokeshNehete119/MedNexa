# Copy to .env and adjust. All variables are prefixed with MEDNEXA_.
MEDNEXA_DATABASE_URL=postgresql+asyncpg://mednexa:mednexa@localhost:5434/mednexa
MEDNEXA_TEST_DATABASE_URL=postgresql+asyncpg://mednexa:mednexa@localhost:5434/mednexa_test
MEDNEXA_DB_POOL_SIZE=10
MEDNEXA_DB_MAX_OVERFLOW=20
MEDNEXA_DB_ECHO=false
MEDNEXA_CORS_ORIGINS=["http://localhost:3000"]
