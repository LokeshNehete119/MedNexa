# Copy to .env and adjust. All variables are prefixed with MEDNEXA_.
MEDNEXA_DATABASE_URL=postgresql+asyncpg://mednexa:mednexa@localhost:5434/mednexa
MEDNEXA_TEST_DATABASE_URL=postgresql+asyncpg://mednexa:mednexa@localhost:5434/mednexa_test
MEDNEXA_DB_POOL_SIZE=10
MEDNEXA_DB_MAX_OVERFLOW=20
MEDNEXA_DB_ECHO=false
MEDNEXA_CORS_ORIGINS=["http://localhost:3000"]
MEDNEXA_DEFAULT_COUNTRY_CODE=91

# ── Authentication (no defaults: the API refuses to start until these are set) ──
# Signing key for staff JWTs: 32+ random characters, e.g. `openssl rand -hex 32`.
MEDNEXA_JWT_SECRET=
MEDNEXA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
MEDNEXA_ADMIN_EMAIL=
MEDNEXA_ADMIN_NAME=Hospital Staff
# The staff password, either plain or a PBKDF2 hash made with:
#   uv run python -m app.core.security
MEDNEXA_ADMIN_PASSWORD=
# Lets the telephony service write call logs (accepted on /calls only). 32+ characters,
# or leave empty to disable. Must match MEDNEXA_TEL_BACKEND_API_KEY.
MEDNEXA_SERVICE_API_KEY=
# Local development without any login (never in production):
# MEDNEXA_AUTH_ENABLED=false
