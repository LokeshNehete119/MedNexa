# ==============================================================================
# MedNexa: configuration for `docker compose` (Part 5)
# ==============================================================================
#   cp .env.example .env     # then fill in every value marked REQUIRED
# .env is git-ignored: never commit real values.
# ==============================================================================

# ── REQUIRED secrets (compose refuses to start without them) ──────────────────
# Generate random values with:  openssl rand -hex 32
POSTGRES_PASSWORD=
MEDNEXA_JWT_SECRET=
# Lets the telephony service write call logs (accepted on /calls only; 32+ characters).
MEDNEXA_SERVICE_API_KEY=

# Staff sign-in for the dashboard. The password may be plain or a PBKDF2 hash made with:
#   docker compose run --rm migration python -m app.core.security
MEDNEXA_ADMIN_EMAIL=
MEDNEXA_ADMIN_PASSWORD=
MEDNEXA_ADMIN_NAME=Hospital Staff

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=mednexa
POSTGRES_USER=mednexa

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Session cookies are Secure by default (http://localhost works). If staff open the
# dashboard over plain HTTP from other machines, set this to false (HTTPS is preferred).
AUTH_COOKIE_SECURE=true

# ── Telephony and voice (Part 3) ──────────────────────────────────────────────
# UUID of the hospital to answer calls for. Create the hospital first (dashboard, or
# `docker compose --profile demo run --rm seed` and read its id from the dashboard/API),
# then set it and run `docker compose up -d telephony`.
MEDNEXA_TEL_HOSPITAL_ID=
# 'edge' (cloud, free, needs internet) or 'piper' (local ONNX binary + voice models)
MEDNEXA_TEL_TTS_ENGINE=edge
MEDNEXA_TEL_WHISPER_MODEL_SIZE=base
MEDNEXA_TEL_WHISPER_DEVICE=cpu
# Twilio (leave empty for local WebSocket testing). With an auth token set, the webhook
# rejects requests that are not signed by Twilio.
MEDNEXA_TEL_TWILIO_ACCOUNT_SID=
MEDNEXA_TEL_TWILIO_AUTH_TOKEN=
MEDNEXA_TEL_TWILIO_PHONE_NUMBER=
# Public HTTPS URL Twilio reaches this server at (no trailing slash)
MEDNEXA_TEL_PUBLIC_URL=

# ── AI agent (Part 2) ─────────────────────────────────────────────────────────
# auto = local model first, cloud on slowness/failure | local = never cloud | cloud = never local
MEDNEXA_AGENT_LLM_MODE=auto
MEDNEXA_AGENT_LOCAL_MODEL=llama3.1:8b
# Optional cloud fallback; only used when its key is set
MEDNEXA_AGENT_CLOUD_PROVIDER=groq
MEDNEXA_AGENT_CLOUD_MODEL=llama-3.3-70b-versatile
MEDNEXA_AGENT_GROQ_API_KEY=
MEDNEXA_AGENT_OPENAI_API_KEY=

# ── Other ─────────────────────────────────────────────────────────────────────
MEDNEXA_DEFAULT_COUNTRY_CODE=91
