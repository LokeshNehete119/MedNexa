# ==============================================================================
# MedNexa — Unified Environment Configuration (Part 5)
# ==============================================================================
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_DB=mednexa
POSTGRES_USER=mednexa
POSTGRES_PASSWORD=mednexa_secret
# Internal URL used by Docker services
DATABASE_URL=postgresql+asyncpg://mednexa:mednexa_secret@db:5432/mednexa
# External URL for host dev tools (port 5434)
MEDNEXA_DATABASE_URL=postgresql+asyncpg://mednexa:mednexa_secret@localhost:5434/mednexa

# --- Redis Cache & Queue ---
REDIS_URL=redis://redis:6379/0

# --- Security & Authentication (JWT - Task 5.3) ---
MEDNEXA_JWT_SECRET=mednexa-super-secret-jwt-signing-key-32bytes-minimum
MEDNEXA_JWT_ALGORITHM=HS256
MEDNEXA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
MEDNEXA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
MEDNEXA_DEFAULT_COUNTRY_CODE=91

# --- AI Agent & LLM (Part 2) ---
# Mode options: auto (try local, fallback to cloud), local (only local), cloud (only cloud)
MEDNEXA_AGENT_LLM_MODE=auto
# Ollama local container URL
MEDNEXA_AGENT_OLLAMA_URL=http://ollama:11434
MEDNEXA_AGENT_LOCAL_MODEL=llama3.1:8b

# Cloud Model (Optional fallback, only used if API keys provided)
MEDNEXA_AGENT_CLOUD_PROVIDER=groq
MEDNEXA_AGENT_CLOUD_MODEL=llama-3.3-70b-versatile
MEDNEXA_AGENT_GROQ_API_KEY=
MEDNEXA_AGENT_OPENAI_API_KEY=

# Router timeouts
MEDNEXA_AGENT_MAX_LATENCY_SECONDS=3
MEDNEXA_AGENT_HINDI_PREFERS_CLOUD=true
MEDNEXA_AGENT_CIRCUIT_FAILURE_THRESHOLD=3
MEDNEXA_AGENT_CIRCUIT_OPEN_SECONDS=300

# --- Telephony & Voice Pipeline (Part 3) ---
MEDNEXA_TEL_BACKEND_URL=http://api:8000
# Target Hospital UUID (from python -m scripts.seed)
MEDNEXA_TEL_HOSPITAL_ID=
# TTS Engine: 'edge' (cloud, free, no keys required) or 'piper' (local ONNX binary)
MEDNEXA_TEL_TTS_ENGINE=edge
MEDNEXA_TEL_WHISPER_MODEL_SIZE=base
MEDNEXA_TEL_WHISPER_DEVICE=cpu
MEDNEXA_TEL_WHISPER_COMPUTE_TYPE=int8
MEDNEXA_TEL_BARGE_IN_ENABLED=true
MEDNEXA_TEL_CALL_TIMEOUT_SECONDS=300
MEDNEXA_TEL_SILENCE_TIMEOUT_SECONDS=30

# Optional Twilio Voice Settings (leave empty for local WebSocket testing)
MEDNEXA_TEL_TWILIO_ACCOUNT_SID=
MEDNEXA_TEL_TWILIO_AUTH_TOKEN=
MEDNEXA_TEL_TWILIO_PHONE_NUMBER=
MEDNEXA_TEL_PUBLIC_URL=

# --- Admin Dashboard UI (Part 4) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXTAUTH_SECRET=mednexa-dashboard-auth-secret
