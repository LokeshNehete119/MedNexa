# Copy to .env and adjust. Agent settings use the MEDNEXA_AGENT_ prefix;
# the database comes from the backend's MEDNEXA_DATABASE_URL.
MEDNEXA_DATABASE_URL=postgresql+asyncpg://mednexa:mednexa@localhost:5434/mednexa

# auto = local first, cloud on slowness/failure | local = never cloud | cloud = never local
MEDNEXA_AGENT_LLM_MODE=auto

# Local model (Ollama): `ollama pull llama3.1:8b`
MEDNEXA_AGENT_OLLAMA_URL=http://localhost:11434
MEDNEXA_AGENT_LOCAL_MODEL=llama3.1:8b

# Cloud model: groq or openai. The cloud is only used when its key is set.
MEDNEXA_AGENT_CLOUD_PROVIDER=groq
MEDNEXA_AGENT_CLOUD_MODEL=llama-3.3-70b-versatile
MEDNEXA_AGENT_GROQ_API_KEY=
MEDNEXA_AGENT_OPENAI_API_KEY=

# Router
MEDNEXA_AGENT_MAX_LATENCY_SECONDS=3
MEDNEXA_AGENT_HINDI_PREFERS_CLOUD=true
MEDNEXA_AGENT_CIRCUIT_FAILURE_THRESHOLD=3
MEDNEXA_AGENT_CIRCUIT_OPEN_SECONDS=300

# Tests only
MEDNEXA_AGENT_TEST_DATABASE_URL=postgresql+asyncpg://mednexa:mednexa@localhost:5434/mednexa_agent_test
